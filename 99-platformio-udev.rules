# 99-platformio-udev.rules - minimal rules to allow access to USB serial devices
# Give read/write access to serial adapters (ttyUSB* and ttyACM*)
KERNEL=="ttyUSB[0-9]*", MODE="0666", GROUP="dialout"
KERNEL=="ttyACM[0-9]*", MODE="0666", GROUP="dialout"

# Optional: common vendor/product examples (uncomment if needed)
# SUBSYSTEM=="usb", ATTR{idVendor}=="2341", ATTR{idProduct}=="0043", MODE="0666", GROUP="dialout"  # Arduino Uno
# SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="7523", MODE="0666", GROUP="dialout"  # CH340
